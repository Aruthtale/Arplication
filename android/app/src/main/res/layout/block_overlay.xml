<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6121212"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_block_card"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍅"
                android:textSize="46sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOKUS DULU!"
                android:textColor="#121212"
                android:textStyle="bold"
                android:textSize="30sp"
                android:letterSpacing="0.02"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/block_app_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi ini diblokir."
                android:textColor="#2A2A2A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sesi Ardoro sedang berjalan. Selesaikan fokusmu dulu ya."
                android:textColor="#4A4A4A"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kembali ke Home…"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</FrameLayout>
