<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sticky_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arnote_sticky_border"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 ARNOTE"
            android:textColor="#121212"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/widget_sticky_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#121212"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Content Container -->
    <LinearLayout
        android:id="@+id/widget_sticky_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_sticky_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textSize="12sp"
            android:maxLines="10"
            android:lineSpacingExtra="2.5dp"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_sticky_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada catatan yang disematkan.\nBuka ArNote &amp; sematkan catatan."
            android:textColor="#121212"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
