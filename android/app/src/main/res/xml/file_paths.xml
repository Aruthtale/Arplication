<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App-private dirs (aman: hanya milik paket ini) -->
    <cache-path name="my_cache_images" path="." />
    <external-cache-path name="my_external_cache" path="." />
    <external-files-path name="my_external_files" path="." />
    <files-path name="my_files" path="." />
    <!--
      Dipersempit ke folder hasil unduhan Aruthtale saja.
      external-path = Environment.getExternalStorageDirectory() + subpath
      Download/Aruthtale — device-independent, tanpa hardcode device path.
      APK update diunduh ke Download/Aruthtale/Arplication/ sehingga tetap
      tercakup; file di luar Aruthtale TIDAK bisa di-share via FileProvider.
    -->
    <external-path name="aruthtale_download" path="Download/Aruthtale/" />
</paths>
